StarterGui "StarterGui" ScreenOrientation=Sensor ShowDevelopmentGui {
    LocalScript "BildingScript" @src="Scripts/StarterGui/BildingScript.luau"
    LocalScript "First Person" @src="Scripts/StarterGui/First Person.luau"
