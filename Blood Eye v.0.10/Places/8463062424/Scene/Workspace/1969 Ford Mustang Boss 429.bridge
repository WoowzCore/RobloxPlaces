        LocalScript "Drag" @code=<<<
            local car = script.Parent.Car.Value
            local sound = car.Body.Drag.Wind
            sound:Play()

            while wait() do
            	sound.Volume = car.DriveSeat.Velocity.magnitude/50
            	car.Body.Drag.T.Force = Vector3.new(0,0,car.DriveSeat.Velocity.magnitude*1.1)
            end
        >>>
