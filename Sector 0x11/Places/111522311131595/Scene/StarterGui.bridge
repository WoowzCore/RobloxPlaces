StarterGui "StarterGui" ScreenOrientation=Sensor ShowDevelopmentGui {
    Folder "Storage" {
        Frame "Notification" Size=0,200,0,50 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 {
            Frame "Background" Size=0,200,0,50 BackgroundColor3=#565656 BorderColor3=#000000 BorderSizePixel=0 {
                TextLabel "Text" Size=0,200,0,50 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="Roboto|Regular|Normal" Text="EXAMPLE MESSAGE" TextColor3=#FFFFFF TextSize=14
            }
        }
    }
    ScreenGui "UI" AutoLocalize=false ClipToDeviceSafeArea=false DisplayOrder=1 ResetOnSpawn=false ScreenInsets=DeviceSafeInsets ZIndexBehavior=Sibling {
        Frame "DebugOverlay" Position=1,0,0,0 Size=0,-150,0,75 BackgroundColor3=#7E7E7E BackgroundTransparency=0.5 BorderColor3=#000000 BorderSizePixel=0 {
            TextLabel "AwakeParts" Position=0,0,0,10 Size=0,50,0,10 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="Roboto|Regular|Normal" Text="A.P.: ?" TextColor3=#FFFFFF TextScaled TextSize=14 TextWrapped TextXAlignment=Left
            TextLabel "Coordinates" Position=0,0,0,20 Size=0,100,0,10 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="Roboto|Regular|Normal" Text="Pos: ?, ?, ?" TextColor3=#FFFFFF TextScaled TextSize=14 TextWrapped TextXAlignment=Left
            TextLabel "FPS" Size=0,50,0,10 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="Roboto|Regular|Normal" Text="FPS: ?" TextColor3=#FFFFFF TextScaled TextSize=14 TextWrapped TextXAlignment=Left
            TextLabel "LUA" Position=0,50,0,10 Size=0,50,0,10 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="Roboto|Regular|Normal" Text="LUA: ?" TextColor3=#FFFFFF TextScaled TextSize=14 TextWrapped TextXAlignment=Left
            TextLabel "Ping" Position=0,100,0,10 Size=0,50,0,10 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="Roboto|Regular|Normal" Text="Ping: ?" TextColor3=#FFFFFF TextScaled TextSize=14 TextWrapped TextXAlignment=Left
            TextLabel "Speed" Position=0,100,0,20 Size=0,50,0,10 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="Roboto|Regular|Normal" Text="Spd.: ?" TextColor3=#FFFFFF TextScaled TextSize=14 TextWrapped TextXAlignment=Left
            TextLabel "Step" Position=0,50,0,0 Size=0,50,0,10 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="Roboto|Regular|Normal" Text="Step: ?" TextColor3=#FFFFFF TextScaled TextSize=14 TextWrapped TextXAlignment=Left
            TextLabel "WorldTime" Position=0,100,0,0 Size=0,50,0,10 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="Roboto|Regular|Normal" Text="WT: ?" TextColor3=#FFFFFF TextScaled TextSize=14 TextWrapped TextXAlignment=Left
        }
        Frame "GameOverlay" Size=1,0,1,0 AutoLocalize=false BackgroundColor3=#000000 BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 {
            TextLabel "Date" Position=0.5,0,0.087,0 Size=0,200,0,50 AnchorPoint=0.5,0 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="SourceSansPro|Regular|Normal" Interactable=false Text="0" TextColor3=#FFFFFF TextSize=32 {
                UIStroke "UIStroke"
            }
            TextLabel "Warning" Position=0.5,0,0,0 Size=0,200,0,50 AnchorPoint=0.5,0 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="SourceSansPro|Regular|Normal" Interactable=false Text="{Warning_Development}" TextColor3=#FFFFFF TextSize=32 {
                UIStroke "UIStroke"
            }
        }
        Frame "MainMenu" Size=1,0,1,0 AutoLocalize=false BackgroundColor3=#000000 BackgroundTransparency=0.5 BorderColor3=#000000 BorderSizePixel=0 Visible=false {
            TextLabel "PlaceName" Position=0.035,0,0.325,0 Size=0,200,0,50 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="SourceSansPro|Regular|Normal" Text="{PlaceName}" TextColor3=#FFFFFF TextSize=40
            TextButton "PlayButton" Position=0.035,0,0.442,0 Size=0,200,0,50 BackgroundColor3=#FFFFFF BorderColor3=#000000 BorderSizePixel=0 FontFace="SourceSansPro|Regular|Normal" TextColor3=#000000 TextSize=14
        }
        Frame "Notifications" Size=1,0,1,0 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 {
            Frame "List" Position=1,0,1,0 Size=0,-10,0,-10 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 {
                UIListLayout "UIListLayout" HorizontalAlignment=Right Padding=0,2 SortOrder=LayoutOrder VerticalAlignment=Bottom
            }
        }
    }
}
