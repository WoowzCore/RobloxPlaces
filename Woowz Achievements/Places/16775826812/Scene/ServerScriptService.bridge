ServerScriptService "ServerScriptService" {
    Folder "SSS" {
        ModuleScript "AllPlayerSaveData" @src="Scripts/ServerScriptService/SSS/AllPlayerSaveData.luau"
        Script "Other" @code=<<<
            local rs = game:GetService("ReplicatedStorage").RS
            local ss = game:GetService("ServerStorage").SS
            local vd = require(ss.VisualData)

            rs.GetVisualData.OnServerInvoke = function()
            	return vd
            end
        >>>
        Script "SaveAndLoad" @src="Scripts/ServerScriptService/SSS/SaveAndLoad.luau"
    }
}
