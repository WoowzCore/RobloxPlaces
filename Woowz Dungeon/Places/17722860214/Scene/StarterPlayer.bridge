StarterPlayer "StarterPlayer" AutoJumpEnabled CameraMaxZoomDistance=128 CameraMinZoomDistance=0.5 CameraMode=Classic CharacterBreakJointsOnDeath CharacterJumpHeight=7.2 CharacterJumpPower=50 CharacterMaxSlopeAngle=89 CharacterUseJumpPower CharacterWalkSpeed=16 ClassicDeath CreateDefaultPlayerModule DevCameraOcclusionMode=Zoom DevComputerCameraMovementMode=UserChoice DevComputerMovementMode=UserChoice DevTouchCameraMovementMode=UserChoice DevTouchMovementMode=UserChoice EnableMouseLockOption=false HealthDisplayDistance=100 LoadCharacterAppearance=false LuaCharacterController=Default NameDisplayDistance=100 UserEmotesEnabled=false {
    StarterCharacterScripts "StarterCharacterScripts"
    StarterPlayerScripts "StarterPlayerScripts" {
        Folder "Scripts" {
            ModuleScript "GameManager" @src="Scripts/StarterPlayer/StarterPlayerScripts/Scripts/GameManager.luau"
            ModuleScript "PlayerData" @src="Scripts/StarterPlayer/StarterPlayerScripts/Scripts/PlayerData.luau"
            ModuleScript "PlayerModule" @src="Scripts/StarterPlayer/StarterPlayerScripts/Scripts/PlayerModule.luau"
            LocalScript "StartScript" @src="Scripts/StarterPlayer/StarterPlayerScripts/Scripts/StartScript.luau"
        }
    }
}
