        Script "Script" @code=<<<
            local spawn = script.Parent
            spawn.Touched:connect(function(hit)
            	if hit and hit.Parent and hit.Parent:FindFirstChild("Humanoid") then
            		game.ReplicatedStorage.Checkpoint:InvokeClient(game.Players:GetPlayerFromCharacter(hit.Parent),hit,spawn)
            	end
            end)
        >>>
