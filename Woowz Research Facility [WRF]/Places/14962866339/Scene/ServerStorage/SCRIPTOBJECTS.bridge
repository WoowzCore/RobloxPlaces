            ClickDetector "ClickDetector" MaxActivationDistance=5 {
                Script "ClickDetectorScript" RunContext=Server @code=<<<
                    local base = require(game:GetService("ServerScriptService").Base)
                    local data = require(game:GetService("ServerStorage").PLAYERSDATA)
                    local cd = script.Parent
                    local event = script.Event

                    cd.MouseClick:Connect(function(plr)
                    	base.ClickDetector(plr,cd)
                    end)
