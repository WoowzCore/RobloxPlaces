            LocalScript "localscript" Disabled @code=<<<
                local plr = game:GetService("Players").LocalPlayer
                local chr = plr.Character or plr.CharacterAdded:Wait()
                local hum = chr:WaitForChild("Humanoid")
                local base = require(chr:WaitForChild("PlayerBase"))

                while wait() do
                	script.Parent.Text = base.t.g("debug.walkspeed")..math.round(hum.WalkSpeed*100)/100
                end
            >>>
        }
        TextLabel "wday" Position=0.348,0,0.181,0 Size=0.156,0,0.025,0 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderColor3=#000000 BorderSizePixel=0 FontFace="AccanthisADFStd|Regular|Normal" Text="WDay: ?" TextColor3=#FFFFFF TextScaled TextSize=14 TextStrokeTransparency=0.27 TextWrapped TextXAlignment=Left {
