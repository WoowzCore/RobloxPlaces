    StarterPlayerScripts "StarterPlayerScripts" {
        LocalScript "LoadSettings" @code=<<<
            local plr = script.Parent.Parent
            local setting = require(script.Parent:WaitForChild("Settings"))
            local rs = game:GetService("ReplicatedStorage")
            local savedsettings = rs.DataStorage.GetSettings:InvokeServer(setting)

            setting.Update(savedsettings)
            setting.Loaded = true
        >>>
