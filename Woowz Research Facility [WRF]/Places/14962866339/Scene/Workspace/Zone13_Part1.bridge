    MeshPart "Button" Size=0.214,0.29,0.061 Anchored CFrame=150.184,5.225,255.586|0,-90,0 Material=Metal PivotOffset=0,0.353,-0.023|90,0,0 {
        ClickDetector "ClickDetector" MaxActivationDistance=2.85 {
            Script "ClickDetectorScript" RunContext=Server @code=<<<
