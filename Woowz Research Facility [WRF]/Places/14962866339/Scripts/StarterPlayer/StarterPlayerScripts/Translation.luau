t.Auto = true
t.SelectedLanguage = "eng"

t.DebugWarning = false

function t.Get(id)
	local l_base = t.Languages[t.SelectedLanguage]
	local text = l_base[id]
	if text == nil then
		warn("Нету текста ["..id.."] для языка ["..t.SelectedLanguage.."]!")
		text = t.Languages["eng"][id] or t.Languages["rus"][id]
		if text ~= nil and t.DebugWarning then
			text = text.." ["..id.."]"
		end
	end
	if text == nil then
		warn("Нету текста ["..id.."] ни в каком языке!")
		return "["..id.."]"
	end
	
	return text
end

function t.g(id) return t.Get(id) end
function t.G(id) return t.Get(id) end

return t
