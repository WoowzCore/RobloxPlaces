                Script "ReadMe" @src="Scripts/Workspace/Tools/Chest_Firefly/Reward/Firefly Jar/FireFlySwarm/ReadMe.luau"
                Script "SpawnScript" @src="Scripts/Workspace/Tools/Chest_Firefly/Reward/Firefly Jar/FireFlySwarm/SpawnScript.luau"
            }
