    RemoteEvent "LidToggle"
    Folder "Reward" {
        Tool "Cyclotron" Grip=0,0.5,0 TextureContent="http://www.roblox.com/Thumbs/Asset.ashx?width=110&height=110&assetId=101081225" ToolTip="Speeds up time!" {
            RemoteEvent "ChangeTime"
            Part "Handle" Size=1,1,1 Anchored CFrame=-379.649,18.901,388.949|0.007,90,0 CanCollide=false {
                SpecialMesh "Mesh" MeshContent="http://www.roblox.com/asset/?id=101060412    " MeshType=FileMesh Scale=2,2,2 TextureContent="http://www.roblox.com/asset/?id=101060383  "
                ParticleEmitter "ParticleEmitter" Size=0:0.062,1:0.313:0.25 Lifetime=0.5,1 LightEmission=1 Rate=0 RotSpeed=-30,30 Rotation=-90,90 Speed=3,3 SpreadAngle=180,180 Transparency=0:1,0.043:0.306,0.665:0.1,0.871:0.444,1:1 ZOffset=2
                PointLight "PointLight" Brightness=0 Color=#FFFF00 Range=0 Shadows
            }
            LocalScript "LocalScript" @src="Scripts/Workspace/Tools/Chest_Cyclotron/Reward/Cyclotron/LocalScript.luau"
            Script "Script" @code=<<<
                local event = script.Parent.ChangeTime

                event.OnServerEvent:Connect(function(player, newTime)
                	game.Lighting:SetMinutesAfterMidnight(newTime)
                end)
            >>>
        }
    }
    Script "Script" @src="Scripts/Workspace/Tools/Chest_Cyclotron/Script.luau" {
        LocalScript "ChestLocalScript" @code=<<<
            local player = game.Players.LocalPlayer
            local mouse = player:GetMouse()

            mouse.Button1Down:connect(function() -- if the player clicks then ...
            	if script.Chest.Value and mouse.Target and mouse.Target.Name == "Lock" and mouse.Target:IsDescendantOf(script.Chest.Value) then -- if they click the chests lock
            		script.Chest.Value.LidToggle:FireServer() -- fire an event that the script will use
            	end
            end)
        >>> {
            ObjectValue "Chest"
        }
    }
}
