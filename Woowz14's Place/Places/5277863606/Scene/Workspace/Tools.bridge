            Part "Handle" Size=1.3,1.3,2.4 Anchored BottomSurface=Smooth CFrame=438.65,74.458,-88.85|0.002,-90,0 CanCollide=false Color=#C4281C TopSurface=Smooth {
                Sound "CoilSound" AudioContent="http://www.roblox.com/asset/?id=99173388" SoundId="http://www.roblox.com/asset/?id=99173388" Volume=1
                SpecialMesh "Mesh" MeshContent="http://www.roblox.com/asset/?id=16606212" MeshType=FileMesh Scale=0.7,0.7,0.7 TextureContent="http://www.roblox.com/asset/?id=99170547"
            }
            Script "Script" @src="Scripts/Workspace/Tools/Chest_Acceleration_Coil/Reward/Acceleration Coil/Script.luau"
        }
    }
    Script "Script" @src="Scripts/Workspace/Tools/Chest_Acceleration_Coil/Script.luau" {
        LocalScript "ChestLocalScript" @code=<<<
            local player = game.Players.LocalPlayer
            local mouse = player:GetMouse()

            mouse.Button1Down:connect(function() -- if the player clicks then ...
            	if script.Chest.Value and mouse.Target and mouse.Target.Name == "Lock" and mouse.Target:IsDescendantOf(script.Chest.Value) then -- if they click the chests lock
            		script.Chest.Value.LidToggle:FireServer() -- fire an event that the script will use
            	end
            end)
        >>> {
            ObjectValue "Chest"
        }
    }
}
