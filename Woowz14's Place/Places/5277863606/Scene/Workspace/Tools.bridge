            BoolValue "CanActivate" Value
            Part "Handle" Size=1.3,1.3,2.4 Anchored BottomSurface=Smooth CFrame=199.65,-26.009,-357.999|-0.002,90,0 CanCollide=false TopSurface=Smooth {
                SpecialMesh "Mesh" MeshContent="http://www.roblox.com/asset/?id=114046169" MeshType=FileMesh Scale=1.3,1.3,1.3 TextureContent="http://www.roblox.com/asset/?id=129317782 "
                Sound "WooshEnd" AudioContent="http://www.roblox.com/asset/?id=129425664" SoundId="http://www.roblox.com/asset/?id=129425664"
                Sound "WooshStart" AudioContent="http://www.roblox.com/asset/?id=129425637" SoundId="http://www.roblox.com/asset/?id=129425637"
            }
            Script "Script" @src="Scripts/Workspace/Tools/Chest_Invisibility_Cloak/Reward/InvisibilityCloak/Script.luau"
        }
    }
    Script "Script" @src="Scripts/Workspace/Tools/Chest_Invisibility_Cloak/Script.luau" {
        LocalScript "ChestLocalScript" @code=<<<
            local player = game.Players.LocalPlayer
            local mouse = player:GetMouse()

            mouse.Button1Down:connect(function() -- if the player clicks then ...
            	if script.Chest.Value and mouse.Target and mouse.Target.Name == "Lock" and mouse.Target:IsDescendantOf(script.Chest.Value) then -- if they click the chests lock
            		script.Chest.Value.LidToggle:FireServer() -- fire an event that the script will use
            	end
            end)
        >>> {
            ObjectValue "Chest"
        }
    }
}
