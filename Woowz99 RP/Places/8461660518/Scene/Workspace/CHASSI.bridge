        LocalScript "StartEngine" @src="Scripts/Workspace/CHASSI/A-Chassis Tune/Plugins/StartEngine.luau" {
            RemoteEvent "engine" {
                Script "nu" @code=<<<
                    script.Parent.OnServerEvent:connect(function(player,statement)
                    	if statement == true then
                    		script.Parent.Parent.Electrics.Value = true
                    	else
                    		script.Parent.Parent.Electrics.Value = false
                    	end
                    end)
                >>>
            }
        }
        LocalScript "SteeringWheel" @code=<<<
            local car = script.Parent.Car.Value
            script.Parent.Values.SteerC.Changed:connect(function()
            	local ex = 3
            	if script.Parent.Values.SteerC.Value<0 then ex=-3 end
            	car.Misc.Wheel.A.W.DesiredAngle = script.Parent.Values.SteerC.Value^2*math.rad(60)*ex
            end)
        >>>
        Frame "Temperature" Size=1,0,1,0 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderSizePixel=0 {
