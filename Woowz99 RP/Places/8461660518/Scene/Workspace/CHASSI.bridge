ModuleScript "A-Chassis Tune" @src="Scripts/Workspace/CHASSI/A-Chassis Tune.luau" {
    ScreenGui "A-Chassis Interface" {
        ObjectValue "Car"
        BoolValue "ControlsOpen"
        LocalScript "Drive" @src="Scripts/Workspace/CHASSI/A-Chassis Tune/A-Chassis Interface/Drive.luau"
        LocalScript "Gauges" @src="Scripts/Workspace/CHASSI/A-Chassis Tune/A-Chassis Interface/Gauges.luau" {
            RemoteEvent "GaugeFE" {
                Script "GaugeServer" @src="Scripts/Workspace/CHASSI/A-Chassis Tune/A-Chassis Interface/Gauges/GaugeFE/GaugeServer.luau"
            }
        }
        BoolValue "IsOn"
        Folder "Values" {
            BoolValue "ABS"
            BoolValue "ABSActive"
            BoolValue "AutoClutch" Value
            NumberValue "Boost"
            NumberValue "BoostSuper"
            NumberValue "BoostTurbo"
