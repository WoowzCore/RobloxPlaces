                    wait()
                    local car = script.Parent.Parent
                    local horn = script.Parent:WaitForChild("Horn")
                    horn.Parent = car.DriveSeat

                    script.Parent.OnServerEvent:connect(function(pl)
                    	horn:Play()
                    end)
