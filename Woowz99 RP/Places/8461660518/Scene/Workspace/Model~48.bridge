Part "Sign" Size=4,2,1 Anchored CFrame=-335.195,9.51,-954.127|0,-90,0 Color=#957977 Transparency=1 {
    Script "Script" @code=<<<
        local part = script.Parent
        local cf = part.CFrame * CFrame.new(0,-.2,0)

        while wait() do
        	part.CFrame = cf * CFrame.Angles(math.sin((time()*3))/8,0,0) * CFrame.new(0,.2,0)
        end
    >>>
    ManualWeld "Sign Terrain Joint" Part1=@"Workspace/Model~48/Sign"
    SurfaceGui "SurfaceGui" CanvasSize=200,100 {
        TextLabel "TextLabel" Size=1,0,1,0 BackgroundColor3=#000000 BackgroundTransparency=1 BorderColor3=#000000 FontFace="SourceSansPro|Bold|Normal" Text="Youtube" TextColor3=#FFFFFF TextScaled TextSize=48 TextStrokeTransparency=0 TextWrapped
    }
}
