        Part "StopButton" Size=0.4,0.4,0.2 Anchored CFrame=826.063,6.85,140.621|178.742,-68.888,178.938 Material=SmoothPlastic Shape=Cylinder TopSurface=Smooth {
            ClickDetector "ClickDetector"
            Script "Script" @code=<<<
                part = script.Parent

                function click()
                	script.Parent.Parent.RadioSpeaker.Sound:Pause()
                end

                part.ClickDetector.MouseClick:connect(click)
            >>>
            Decal "Stop Button" Face=Left Texture="rbxassetid://12255401" TextureContent="rbxassetid://12255401"
        }
    }
