ModuleScript "A-Chassis Tune" @src="Scripts/Workspace/shopping car drift/A-Chassis Tune.luau" {
    ScreenGui "A-Chassis Interface" {
        ObjectValue "Car"
        BoolValue "ControlsOpen"
        LocalScript "Drive" @src="Scripts/Workspace/shopping car drift/A-Chassis Tune/A-Chassis Interface/Drive.luau"
        BoolValue "IsOn"
        Folder "Values" {
            BoolValue "ABS"
            BoolValue "ABSActive"
            NumberValue "Brake"
            NumberValue "Gear"
            NumberValue "Horsepower"
            Frame "Lights" Position=0,0,0,300 Size=1,0,1,0 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderSizePixel=0 {
                TextButton "L" Position=0.5,-120,1,-40 Size=0,40,0,20 BackgroundColor3=#000000 BackgroundTransparency=0.5 BorderSizePixel=0 FontFace="Arial|Bold|Normal" Text="Lights" TextColor3=#FFFFFF TextSize=14 TextStrokeTransparency=0.9 TextTransparency=0.1 {
                    LocalScript "Lights" @src="Scripts/Workspace/shopping car drift/A-Chassis Tune/A-Chassis Interface/Values/Lights/L/Lights.luau"
                    Sound "Reverse" Looped PlaybackSpeed=0 Volume=0.3 {
                        NumberValue "SetPitch" Value=0.15
                        NumberValue "SetRev" Value=1.3
                        NumberValue "SetVolume" Value=0.1
                        NumberValue "SetVolumeRev" Value=0.5
                    }
                }
            }
            BoolValue "MouseSteerOn"
            BoolValue "PBrake"
            NumberValue "RPM"
            NumberValue "SteerC"
            NumberValue "SteerT"
            BoolValue "TCS"
            BoolValue "TCSActive"
            NumberValue "Throttle"
            NumberValue "Torque"
            StringValue "TransmissionMode"
            Vector3Value "Velocity"
        }
    }
