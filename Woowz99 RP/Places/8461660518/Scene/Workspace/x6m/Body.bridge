VehicleSeat "Seat" Size=0.794,0.181,0.903 Anchored BackSurface=SmoothNoOutlines BottomSurface=SmoothNoOutlines CFrame=-126.493,5.299,31.487|0.015,0.014,-0.017 CanCollide=false Color=#111111 FrontSurface=SmoothNoOutlines HeadsUpDisplay=false LeftSurface=SmoothNoOutlines Material=SmoothPlastic MaxSpeed=0 RightSurface=SmoothNoOutlines TopSurface=SmoothNoOutlines Torque=0 Transparency=1 TurnSpeed=0 {
    Script "Player Positioner" @code=<<<
        script.Parent.ChildAdded:connect(function(child) 
        	if child:IsA("Weld") and game.Players:GetPlayerFromCharacter(child.Part1.Parent)~=nil then 
        		local P=game.Players:GetPlayerFromCharacter(child.Part1.Parent) 
        		local S=script.L:Clone() S.Parent=P.PlayerGui 
        		S.Seat.Value=script.Parent 
        		S.Disabled=false 
        	end 
        end)
    >>> {
        LocalScript "L" @src="Scripts/Workspace/x6m/Body/Seat/Player Positioner/L.luau" Disabled {
            ObjectValue "Seat"
        }
    }
}
