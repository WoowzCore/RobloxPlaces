StarterPlayer "StarterPlayer" AutoJumpEnabled CameraMaxZoomDistance=128 CameraMinZoomDistance=0.5 CameraMode=Classic CharacterBreakJointsOnDeath CharacterJumpHeight=7.2 CharacterJumpPower=50 CharacterMaxSlopeAngle=89 CharacterUseJumpPower=false CharacterWalkSpeed=16 ClassicDeath CreateDefaultPlayerModule DevCameraOcclusionMode=Zoom DevComputerCameraMovementMode=UserChoice DevComputerMovementMode=UserChoice DevTouchCameraMovementMode=UserChoice DevTouchMovementMode=UserChoice EnableMouseLockOption HealthDisplayDistance=100 LoadCharacterAppearance=false LuaCharacterController=Default NameDisplayDistance=100 UserEmotesEnabled=false {
    StarterCharacterScripts "StarterCharacterScripts" {
        Folder "Value"
    }
    StarterPlayerScripts "StarterPlayerScripts" {
        LocalScript "Player" @src="Scripts/StarterPlayer/StarterPlayerScripts/Player.luau"
    }
}
