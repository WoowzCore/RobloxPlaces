StarterGui "PlayerGui" ScreenOrientation=Sensor ShowDevelopmentGui {
    ScreenGui "GUI" ScreenInsets=DeviceSafeInsets ZIndexBehavior=Sibling {
        TextLabel "DeadText" Position=0.299,0,0,0 Size=0,620,0,155 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderSizePixel=0 FontFace="SourceSansPro|Regular|Normal" Text="YOU ARE DEAD" TextColor3=#FF8000 TextScaled TextSize=34 TextStrokeColor3=#FF0004 TextStrokeTransparency=0 TextWrapped Visible=false
        TextLabel "DeadText2" Position=0.408,0,0.151,0 Size=0,281,0,51 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderSizePixel=0 FontFace="SourceSansPro|Regular|Normal" Text="Press [SPACE] to respawn" TextColor3=#FF8000 TextScaled TextSize=34 TextStrokeColor3=#FF0004 TextStrokeTransparency=0 TextWrapped Visible=false
        TextLabel "DeadText3" Position=0.384,0,0.226,0 Size=0,358,0,64 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderSizePixel=0 FontFace="SourceSansPro|Regular|Normal" Text="{Reason : dead }" TextColor3=#737373 TextScaled TextSize=34 TextStrokeTransparency=0 TextWrapped Visible=false
        TextLabel "Id" Position=0.847,0,0.567,0 Size=0,235,0,42 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderSizePixel=0 FontFace="PatrickHand|Regular|Normal" LineHeight=0.75 Text="Your Id {ERROR}" TextColor3=#9D9D9D TextScaled TextSize=28 TextStrokeTransparency=0 TextWrapped TextYAlignment=Top
        ImageLabel "InWater" Size=1,0,1,0 AutomaticSize=XY BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderSizePixel=0 Image="rbxassetid://8697445295" ImageContent="rbxassetid://8697445295" ScaleType=Tile Visible=false
        TextLabel "Info" Position=0.864,0,0.629,0 Size=0,198,0,158 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderSizePixel=0 FontFace="PatrickHand|Regular|Normal" LineHeight=0.75 Text="Create Object = \"E\"   Change Object = \"Q , 1\"   Delete Object = \"R\"   Ragdollize = \"Z\"        Clear All Objects = \"T\"  " TextColor3=#FFFFFF TextSize=28 TextStrokeTransparency=0 TextWrapped TextYAlignment=Top
        TextLabel "PlayerColor" Position=0.876,0,0.859,0 Size=0,189,0,15 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderSizePixel=0 FontFace="GothamSSm|Bold|Normal" LineHeight=0.75 Text="Color {1}" TextColor3=#FFFFFF TextScaled TextSize=29 TextStrokeColor3=#FFFFFF TextStrokeTransparency=0 TextWrapped TextYAlignment=Top
        TextLabel "PlayerInfo" Position=0.118,0,0.882,0 Size=0,1259,0,49 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderSizePixel=0 FontFace="Oswald|Regular|Normal" LineHeight=0.75 Text="ERROR!!! ERROR!!! ERROR!!! ERROR!!! ERROR!!!" TextColor3=#FFFFFF TextSize=49 TextStrokeTransparency=0 TextWrapped TextYAlignment=Top
        TextLabel "SpawnThis" Position=0.864,0,0.881,0 Size=0,200,0,50 BackgroundColor3=#FFFFFF BackgroundTransparency=1 BorderSizePixel=0 FontFace="GothamSSm|Bold|Normal" Text="Object" TextColor3=#540000 TextScaled TextSize=14 TextStrokeColor3=#FFFFFF TextStrokeTransparency=0 TextWrapped
    }
    LocalScript "GUIscript" @src="Scripts/StarterGui/GUIscript.luau"
    LocalScript "LocalWeather" @src="Scripts/StarterGui/LocalWeather.luau"
    LocalScript "Player" @src="Scripts/StarterGui/Player.luau"
    ScreenGui "Vignette" ScreenInsets=DeviceSafeInsets ZIndexBehavior=Sibling {
        ImageLabel "ImageLabel" Size=1,0,1,0 BackgroundColor3=#FFFFFF BackgroundTransparency=1 Image="rbxassetid://10548483470" ImageContent="rbxassetid://10548483470" ImageTransparency=0.7
    }
    Folder "ragdoll" {
        Folder "events" {
            BindableEvent "resetclient"
            RemoteEvent "variableserver"
        }
        Folder "functions" {
            BindableFunction "ragdoll"
            RemoteFunction "remoteragdoll"
            RemoteFunction "remoteragdollvelocity"
        }
        LocalScript "ragdollclient" @src="Scripts/StarterGui/ragdoll/ragdollclient.luau"
        Script "ragdollserver" @src="Scripts/StarterGui/ragdoll/ragdollserver.luau"
        Folder "variables" {
            BoolValue "ragdoll"
            BoolValue "ragdollonclient"
        }
    }
}
