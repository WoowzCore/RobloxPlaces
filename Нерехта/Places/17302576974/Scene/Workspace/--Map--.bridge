Model "Glowstick" {
    Part "GlowPart" Size=1.091,0.136,0.682 BottomSurface=Smooth CFrame=113.943,2.568,-32.848|0,0,-180 Material=Neon Shape=Cylinder TopSurface=Smooth {
        PointLight "PointLight" Brightness=4 Range=10 Shadows {
            Script "GlowstickScript" @code=<<<
                local colors = {
